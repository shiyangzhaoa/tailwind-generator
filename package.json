{
  "name": "tailwind-generator",
  "version": "0.0.2-beta.1",
  "description": "This project was bootstrapped by CLI",
  "type": "module",
  "contributors": [
    "shiyangzhaoa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyangzhaoa/tailwind-generator.git"
  },
  "files": [
    "esm"
  ],
  "main": "./esm/index.mjs",
  "exports": {
    ".": {
      "types": "./esm/index.d.mts",
      "default": "./esm/index.mjs"
    }
  },
  "sideEffects": false,
  "types": "./esm/index.d.mts",
  "scripts": {
    "build": "rimraf esm && tsc -b ./tsconfig.json",
    "build:w": "tsc -b ./tsconfig.json -w",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules  --no-warnings\" jest -c ./__tests__/jest.config.mjs --detectOpenHandles",
    "start": "NODE_OPTIONS=\"--experimental-vm-modules  --no-warnings\"  jest -c ./__tests__/jest.config.mjs --watchAll --runInBand",
    "generate:mappings": "node scripts/generate-mappings.mjs",
    "check:mappings": "node scripts/generate-mappings.mjs --check",
    "typecheck": "tsc --noEmit -p __tests__/tsconfig.json",
    "test:browser": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:mappings": "node scripts/verify-mappings.mjs"
  },
  "dependencies": {
    "colorjs.io": "^0.5.2",
    "csstype": "^3.1.3",
    "postcss-value-parser": "^4.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^5.36.2",
    "@typescript-eslint/parser": "^5.36.2",
    "codecov": "^3.8.3",
    "es-module-lexer": "^1.5.0",
    "eslint": "8.49.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29",
    "jest-watch-typeahead": "~2.2.0",
    "node-notifier": "^10.0.1",
    "prettier": "^3.2.5",
    "rimraf": "3.0.2",
    "tailwindcss": "4.1.18",
    "ts-jest": "^29",
    "typescript": "5.4.2"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  }
}
